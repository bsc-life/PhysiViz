# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# exporter python venv (created by scripts/install.sh)
exporter/.venv/

# PhysiCell source checkout used by scripts/demo_from_physicell_sample.sh
exporter/.physicell_sample_src/

# exported datasets (your own runs, and the generated demo) are local --
# nothing under public/data/ ships in the repo. See public/data/README.md.
/public/data/*
!/public/data/README.md
